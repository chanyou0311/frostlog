[Unit]
Description=frostlog: record what the gateway hears from the cooler
# The gateway holds the link; without it there is nothing to record. Started with
# this unit, and not required by it: a gateway that is down is waited for, and the
# waiting is itself a record.
Wants=frostlog-gateway.service
After=frostlog-gateway.service

[Service]
Type=simple
EnvironmentFile=-%E/frostlog/env
StateDirectory=frostlog
ExecStart=%h/frostlog/.venv/bin/frostlog read cooler --output %S/frostlog
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
