# frostlog settings, read by the systemd units (KEY=value, no "export").
# Copy to ~/.config/frostlog/env (mode 600). Empty values mean "use the default".

# The environment sensor (DHT20) is read with every cooler message over this bus.
FROSTLOG_I2C_BUS=1

# The cooler the gateway connects to; find it with `frostlog-gateway scan`. The
# whole of frostlog reads this one file, and the gateway is what these two are for.
FROSTLOG_COOLER_MODEL=everfrost
FROSTLOG_COOLER_ADDRESS=

# Where the gateway's sockets are, and where this collector looks for them. Both
# units have the same default, so this is only for running them by hand.
FROSTLOG_GATEWAY_SOCKET_DIR=

# Google Cloud Storage through its S3-compatible XML API; the keys are HMAC keys.
FROSTLOG_S3_ENDPOINT=https://storage.googleapis.com
FROSTLOG_S3_BUCKET=chanyou-frostlog-collection
FROSTLOG_S3_ACCESS_KEY_ID=
FROSTLOG_S3_SECRET_ACCESS_KEY=

# Optional dead man's switch (e.g. healthchecks.io): pinged after every upload run
# that reached the bucket and had no failures or conflicts.
FROSTLOG_HEALTHCHECK_URL=
