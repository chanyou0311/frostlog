[Unit]
Description=frostlog: read the %i ambient temperature and humidity sensor

[Service]
Type=simple
EnvironmentFile=-%E/frostlog/env
StateDirectory=frostlog
ExecStart=%h/frostlog/.venv/bin/frostlog read ambient --sensor %i --output %S/frostlog
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
