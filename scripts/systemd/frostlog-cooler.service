[Unit]
Description=frostlog: receive what the cooler sends over Bluetooth

[Service]
Type=simple
EnvironmentFile=-%E/frostlog/env
# Without a pinned address the receiver would latch onto any nearby Anker device,
# so the service is skipped (not failed) until FROSTLOG_COOLER_ADDRESS is set.
ExecCondition=/bin/sh -c 'test -n "$FROSTLOG_COOLER_ADDRESS"'
StateDirectory=frostlog
ExecStart=%h/frostlog/.venv/bin/frostlog read cooler --output %S/frostlog
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
