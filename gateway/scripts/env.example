# frostlog settings, read by the systemd units (KEY=value, no "export").
# Copy to ~/.config/frostlog/env (mode 600). Empty values mean "use the default".
# The whole of frostlog reads this one file; the collector's example has the rest.

FROSTLOG_COOLER_MODEL=everfrost
# Required by the gateway; find it with `frostlog-gateway scan`.
FROSTLOG_COOLER_ADDRESS=

# Where the gateway's sockets live, and where its clients look for them. The unit
# has a runtime directory of its own, so this is only for running it by hand.
FROSTLOG_GATEWAY_SOCKET_DIR=
